# ============================================
# Configurações do Chatbot
# ============================================

# URL do servidor Ollama (padrão: http://localhost:11434/api/generate)
OLLAMA_URL=http://localhost:11434/api/generate

# Modelo a ser utilizado no Ollama (padrão: mistral)
MODEL=mistral

# ============================================
# Configurações do Twilio WhatsApp
# ============================================
# Obtenha essas credenciais em: https://console.twilio.com

# SID da conta Twilio
TWILIO_ACCOUNT_SID=your_account_sid_here

# Auth Token da conta Twilio
TWILIO_AUTH_TOKEN=your_auth_token_here

# Número do WhatsApp Twilio (sandbox ou número oficial)
# Exemplo: whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
